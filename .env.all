# Core / unified build — the whole IE Pulse shell in one bundle.
# VITE_APPS (>1) makes buildContext include all these modules' routes and show
# the app switcher; vite.config sees the multi-app list and builds at base
# /ietools/ → output dist/all. Host it at /ietools/ behind one nginx block.
# (Omit VITE_APP_ID on purpose — this build is not a single app.)
VITE_APPS=pulse,ole,cycle-time,ppqt,ipk,lbr,va-nva,fsms,machine-mover,ebuild,iebaseline
